{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Suno 批量下载助手",
  "version": "0.2.3",
  "description": "侧边栏识别、勾选并批量下载已授权的 Suno 歌曲；依赖第三方解析服务。",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://download.ai-suno.com/*"
  ],
  "action": {
    "default_title": "打开 Suno 下载侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

